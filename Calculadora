6. `app/src/main/java/com/tuapp/calculadorauber/UberReaderService.kt`
package com.tuapp.calculadorauber
import android.accessibilityservice.AccessibilityService
import android.view.accessibility.AccessibilityEvent
import android.view.accessibility.AccessibilityNodeInfo
import android.graphics.PixelFormat
import android.view.*
import android.widget.*

class UberReaderService : AccessibilityService() {
    private var floatView: View? = null
    private var wm: WindowManager? = null
    private var paradas = 0

    override fun onAccessibilityEvent(event: AccessibilityEvent) {
        if (event.eventType != AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED && event.eventType != AccessibilityEvent.TYPE_WINDOW_CONTENT_CHANGED) return
        val root = rootInActiveWindow ?: return
        val texto = StringBuilder()
        fun recorrer(n: AccessibilityNodeInfo?) {
            if (n == null) return
            if (n.text != null) texto.append(n.text.toString() + " | ")
            for (i in 0 until n.childCount) recorrer(n.getChild(i))
        }
        recorrer(root)
        val t = texto.toString()
        if (!t.contains("PEN") || !t.contains("Viaje:")) return

        val pago = Regex("PEN([0-9]+\\.[0-9]+)").find(t)?.groupValues?.get(1)?.toFloatOrNull() ?: return
        val minRecojo = Regex("A (\\d+) min").find(t)?.groupValues?.get(1)?.toIntOrNull() ?: return
        val minViaje = Regex("Viaje: (\\d+) min").find(t)?.groupValues?.get(1)?.toIntOrNull() ?: return
        val kmViaje = Regex("Viaje:.*?(\\d+\\.\\d+) km").find(t)?.groupValues?.get(1)?.toFloatOrNull() ?: 0f
        val kmRecojo = Regex("A \\d+ min \\((\\d+\\.\\d+) km\\)").find(t)?.groupValues?.get(1)?.toFloatOrNull() ?: 0f

        val tiempoTotal = minRecojo + minViaje + (paradas * 15)
        var miPrecio = (tiempoTotal / 60.0) * 40.0
        if (miPrecio < 15.0) miPrecio = 15.0
        val diff = pago - miPrecio
        val estado = when {
            diff > 0.5 -> "CONVIENE +S/%.2f".format(diff)
            diff < -0.5 -> "NO CONVIENE -S/%.2f".format(-diff)
            else -> "EMPATE S/0.00"
        }
        mostrarBarra(tiempoTotal, kmRecojo + kmViaje, miPrecio, pago, estado, diff)
    }

    private fun mostrarBarra(tiempo: Int, km: Float, miPrecio: Double, uber: Float, estado: String, diff: Double) {
        if (floatView == null) {
            wm = getSystemService(WINDOW_SERVICE) as WindowManager
            floatView = LayoutInflater.from(this).inflate(R.layout.flotante_barra, null)
            val params = WindowManager.LayoutParams(
                WindowManager.LayoutParams.MATCH_PARENT,
                WindowManager.LayoutParams.WRAP_CONTENT,
                WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,
                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL,
                PixelFormat.TRANSLUCENT
            )
            params.gravity = Gravity.TOP
            params.y = 10
            wm?.addView(floatView, params)
            floatView?.findViewById<Button>(R.id.btnMas)?.setOnClickListener { paradas++; }
            floatView?.findViewById<Button>(R.id.btnMenos)?.setOnClickListener { if (paradas > 0) paradas--; }
        }
        floatView?.findViewById<TextView>(R.id.txtInfo)?.text =
            "$tiempo min | %.1f km | TU: S/%.2f | UBER: S/%.2f | $estado".format(km, miPrecio, uber)
        val color = if (diff > 0.5) 0xFF1B8C3A.toInt() else if (diff < -0.5) 0xFFD32F2F.toInt() else 0xFFE67E00.toInt()
        floatView?.findViewById<TextView>(R.id.txtInfo)?.setTextColor(color)
    }
    override fun onInterrupt() {}
}
